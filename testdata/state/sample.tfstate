{
  "version": 4,
  "terraform_version": "1.9.0",
  "serial": 1,
  "lineage": "00000000-0000-0000-0000-000000000000",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "google_compute_instance",
      "name": "web",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "web-1",
            "machine_type": "e2-medium",
            "zone": "us-central1-a",
            "deletion_protection": false,
            "can_ip_forward": false,
            "description": "web frontend",
            "labels": { "env": "prod" }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_storage_bucket",
      "name": "data",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "my-app-data-bucket",
            "location": "US",
            "storage_class": "STANDARD",
            "versioning_enabled": true,
            "uniform_bucket_level_access": true,
            "labels": { "team": "platform" }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_firewall",
      "name": "allow_ssh",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "allow-ssh",
            "direction": "INGRESS",
            "priority": 1000,
            "allowed": ["tcp:22"],
            "disabled": false
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_network",
      "name": "main",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "main-vpc",
            "auto_create_subnetworks": false,
            "routing_mode": "REGIONAL",
            "description": "primary VPC"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_subnetwork",
      "name": "main",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "main-subnet",
            "ip_cidr_range": "10.0.0.0/24",
            "region": "us-central1",
            "private_ip_google_access": true
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_disk",
      "name": "data_disk",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "data-disk-1",
            "size_gb": 100,
            "type": "pd-ssd",
            "zone": "us-central1-a",
            "labels": { "purpose": "database" }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_address",
      "name": "lb_ip",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "lb-static-ip",
            "address_type": "EXTERNAL",
            "region": "us-central1"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account",
      "name": "app_sa",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "account_id": "app-service",
            "display_name": "Application Service Account",
            "description": "used by the app backend",
            "disabled": false
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_pubsub_topic",
      "name": "events",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "name": "app-events",
            "message_retention_duration": "86400s",
            "labels": {}
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_bigquery_dataset",
      "name": "analytics",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "dataset_id": "analytics",
            "location": "US",
            "description": "analytics warehouse"
          }
        }
      ]
    }
  ]
}
